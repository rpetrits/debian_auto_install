#!/bin/sh

WORK_DIR=$(pwd)
ISO_NAME="debian-13.5.0-amd64-netinst.iso"
ISO_URL="https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/$ISO_NAME"
OUTPUT_ISO="debian-preseed.iso"

# Aufräumen bei Fehler oder Abbruch
cleanup() {
    rm -f initrd.gz initrd_master.gz
}
trap cleanup EXIT

echo "================================================="
echo " Start: Automatische Erstellung des Preseed-ISOs"
echo "================================================="

# 1. Prüfen, ob das originale Debian-ISO existiert, ansonsten herunterladen
if [ ! -f "$ISO_NAME" ]; then
    echo "[1/4] Originales Debian-ISO nicht gefunden. Starte Download..."
    curl -L -O "$ISO_URL" || { echo "FEHLER: Download fehlgeschlagen!"; exit 1; }
else
    echo "[1/4] Originales Debian-ISO ist bereits vorhanden. Überspringe Download."
fi

# 2. initrd.gz aus dem ISO extrahieren
echo "[2/4] Extrahiere initrd.gz aus dem ISO..."
xorriso -osirrox on -indev "$ISO_NAME" \
    -extract /install.amd/initrd.gz ./initrd.gz \
    || { echo "FEHLER: Extraktion fehlgeschlagen!"; exit 1; }

chmod +w initrd.gz

# 3. preseed.cfg via inject.py in die initrd injizieren
echo "[3/4] Führe inject.py aus..."
if [ ! -f "inject.py" ]; then
    echo "FEHLER: 'inject.py' nicht gefunden!"
    exit 1
fi
python3 inject.py || { echo "FEHLER: inject.py wurde mit Fehlern abgebrochen!"; exit 1; }

# 4. Neues ISO bauen: initrd und grub.cfg aus dem Repo einbetten
echo "[4/4] Erstelle das modifizierte ISO mit xorriso..."
rm -f "$OUTPUT_ISO"

xorriso \
  -indev "$ISO_NAME" \
  -outdev "$OUTPUT_ISO" \
  -overwrite on \
  -boot_image any replay \
  -map initrd_master.gz /install.amd/initrd.gz \
  -map grub.cfg /boot/grub/grub.cfg \
  || { echo "FEHLER: xorriso konnte das ISO nicht bauen!"; exit 1; }

echo "================================================="
echo " FERTIG! Dein Image liegt bereit unter:"
echo " $WORK_DIR/$OUTPUT_ISO"
echo "================================================="
